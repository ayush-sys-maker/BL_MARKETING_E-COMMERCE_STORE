<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart | BL MARKETING</title>

      <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@301&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="cart.css"> 

    <style>.hide-scrollbar {
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE/Edge */
}

.hide-scrollbar::-webkit-scrollbar {
  display: none; /* Chrome/Safari/Opera */
}

/* CART CARD */
.cart-card {
  background: #fff;
  border-radius: 14px;
  overflow: hidden;
  max-width: 740px;
}

.cart-card-inner {
  display: flex;
  min-height: 220px;
}

/* IMAGE SIDE */
.cart-image {
  width: 50%;
  background: #f5f5f5;
}

.cart-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* CONTENT SIDE */
.cart-content {
  width: 50%;
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 10px;
}

.product-price {
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 12px;
}

.product-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 14px;
  color: #555;
}

/* BUTTON AREA */
.cart-action {
  display: flex;
  justify-content: flex-end;
}

.cartimage{
  height: 300px;
  width: 200px;
}

/* MOBILE VIEW */
@media (max-width: 768px) {
  .cart-card-inner {
    flex-direction: column;
  }

  .cart-image,
  .cart-content {
    width: 100%;
  }

  .cart-image img {
    height: 220px;
  }

  .cart-content {
    gap: 16px;
  }


  .cartimage{
  height: 400px;
  width: 300px;
}
}



          @media (min-width: 992px) {
            .navbar .d-flex {
                margin-left: 250px;
            }
            .navbar form {
                margin-left: 3rem;
            }
            .mob{
              display: none;
            }
            .navbar{
            height: 60px;
            }
        }
        

        @media (max-width: 991.98px) {
    .navbar .d-flex {
        margin-left: 0 !important;
        justify-content: flex-start;
        width: 100%;
        
    }


  }

 .navbar-brand>img{
       width: 100px;
       height: 100px;
        }



</style>

</head>
<body>


 
  
    
<!--NAVBAR--> 
<header class="sticky-top bg-white shadow-sm">
  <nav class="navbar navbar-expand-lg container py-3">
    <div class="container-fluid">
      <!-- Logo/Brand -->
<div class="navbar-brand" href="#">
        <img class="img-fluid" src="/Bl_logo.png" alt="Bl_logo">
      </div>        
      <!-- Mobile Toggle -->
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
        <span class="navbar-toggler-icon"></span>
      </button>
      
      <!-- Main Content -->
      <div class="collapse navbar-collapse" id="navbarContent">
        <!-- Menu -->
        <ul class="navbar-nav gap-lg-4 gap-2 ms-lg-5 ps-lg-5 mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link" href="/home">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/sportswear">Sportswear</a></li>
          <li class="nav-item"><a class="nav-link" href="/WOMEN">Women</a></li>
          <li class="nav-item"><a class="nav-link" href="/SOCKS">Socks </a></li>
        </ul>
        
        <!-- Search -->
        <form class="d-flex ms-lg-5 me-lg-0 mx-auto my-2 my-lg-0" role="search"  action="/search" method="get"  >
          <div class="input-group   ">
            <input class="form-control" type="search" placeholder="Search" name="q">
            <button class="btn btn-outline-secondary" type="submit">
              <i class="fas fa-search"></i>
            </button>
          </div>
        </form>
        
        <!-- Actions -->
        <div class="d-flex gap-2 align-items-center ms-lg-5">
        
        
       


<!-- Cart button -->


 <% if(!user){ %>
  <!-- Login button -->
  <button type="button" class="btn" data-bs-toggle="modal" data-bs-target="#signInModal">
    Sign In
  </button>
  <button type="button" class="btn" data-bs-toggle="modal" data-bs-target="#loginModal">
   Login
  </button>
  <% }else{ %>
    <button  class="btn btn-dark  rounded-pill" onclick="window.location.href='/order/my-orders'" style="font-size: small;"  >MY ORDER</button>

  <form action="/auth/logout" method="post">
  <button type="submit" class="btn fs-6 " >
   <i class="fas fa-sign-out-alt"></i>
  </button>

  </form>
  <% } %>
  <button class="btn position-relative p-1">
    <a href="/cart"><i class="fas fa-shopping-cart fs-5"></i></a>
   </button>

        </div>
      </div>
    </div>
  </nav>
</header>
    


<div class="main d-flex flex-column flex-lg-row align-items-stretch">

  <!-- CART -->
  <div class="col-lg-7  d-flex flex-column ms-0 ms-lg-5 gap-4 scroll-container hide-scrollbar" style="max-height: 650px; overflow-y: auto;">
    <% if ( !cart || cart.length === 0) { %>
      <div class="shop d-flex justify-content-center">
        <img class="w-75 w-md-50 h-auto" style="margin-top: 100px;" src="cart.png" alt=" ">
      </div>
    <% } %>
    <% cart.forEach(function(product) { %>
      <div class="card col-6 mb-3 mt-4 mt-lg-5 shadow-lg mx-2 mx-lg-5" style="max-width: 100%; width: 100%; max-width: 740px;">
        <div  class="row g-2 flex-column flex-md-row">
          <div class="col-12 col-md-4  imagebox   ">
            
              <img src="/<%= product.images %>" class="d-block w-100 cartimage  " alt="Product Image">
           
          </div>
          <div class="col-12 col-md-8">
            <div class="card-body">
              <h5 class="card-title mb-3"><%= product.name %></h5>
              <p class="card-text mb-3">₹<%= product.price %></p>
              <p> Color :<%= product.color %></p>
              <p> Size : <%= product.size %></p>

  <select
    name="quantity"
    class="form-select quantity w-50"
    data-cart-id="<%= product.id %>"
    data-price = "<%= product.price %>"
  >
    
    <option value="1" <%= product.quantity == 1 ? 'selected' : '' %>     > Qty: 1</option>
    <option value="2" <%= product.quantity == 2 ? 'selected' : ''    %>  >Qty: 2</option>
    <option value="3"  <%= product.quantity == 3 ? 'selected' : '' %>    >Qty: 3</option>
    <option value="4" <%= product.quantity == 4 ? 'selected' : '' %>     >Qty: 4</option>
    <option value="5" <%= product.quantity == 5 ? 'selected' : '' %>     >Qty: 5</option>
  </select>

 
         
              <div class="d-flex flex-row gap-2 justify-content-end mt-3">
                <form action="/cart/remove/<%= product.id %>" method="POST" style="display:inline;">
              
                  <button type="submit" class="btn btn-dark">Remove</button>
                </form>
             
              </div>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  </div>

  <!-- SUMMARY -->
  <div class="card col-12 col-lg-5 mt-4 mt-lg-5 ms-0 ms-lg-5 shadow-lg" style="width: 100%; max-width: 22rem; height: auto;">
    <div class="card-body">
      <h5 class="card-title text-center">ORDER SUMMARY</h5>
      <h6 class="card-subtitle mb-2 text-body-secondary text-center text-decoration-underline" style="margin-top: 30px;">BILL DETAILS</h6>
      <div class="mt-4">
        <div class="d-flex justify-content-between">
          <span>Subtotal:</span>
          <span>₹<span id="subtotal"><%= total %></span></span>
        </div>
        <div class="d-flex justify-content-between">
          <span>Discount:</span>
          <span>-₹<span id="discount">0</span></span>
        </div>
        <div class="d-flex justify-content-between">
          <span>Shipping:</span>
          <span>₹<span id="shipping">0</span></span>
        </div>
        <hr>
        <div class="d-flex justify-content-between fw-bold">
          <span>Total:</span>
          <span>₹<span id="total"><%= total %></span></span>
        </div>
      </div>
      <div class="input-group mt-3">
        <input type="text" class="form-control" placeholder="Apply coupon code">
        <button class="btn btn-outline-primary">Apply</button>
      </div>
      <div class="d-grid mt-3">
        <button   onclick="window.location.href='/payment/Checkout'"   class="btn btn-success py-2">
          <i class="fas fa-lock me-2"></i>Proceed to Checkout
        </button>
      </div>
     
      </div>
    </div>
  </div>
</div>

<!-- Responsive tweaks -->
<style>
@media (max-width: 991.98px) {
  .main {
    flex-direction: column !important;
  }
  .ms-lg-5 {
    margin-left: 0 !important;
  }
  .mt-lg-5 {
    margin-top: 1.5rem !important;
  }
  .card {
    max-width: 100% !important;
    width: 100% !important;
  }
}
</style>

<!--footer-->





















<!-- Sign In Modal -->
<div class="modal fade" id="signInModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Sign In</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form  action="/auth/signup" method="post"   >
          <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" name="name" class="form-control w-100 " required autocomplete="off" >
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="username" class="form-control w-100 " required autocomplete="off" >
          </div>
          <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control  w-100 " required  autocomplete="new-password" >
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-primary">Sign In</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="loginModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Login</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form action="/auth/login" method="post"   >
          <div class="mb-3  ">
            <label class="form-label">Username</label>
            <input type="text" name="username" class="form-control w-100 " required  autocomplete="off" >
          </div>
          <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control  w-100 " required  autocomplete="new-password"  >
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-primary">Login</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>



</body>


<script>

const quantitySelects = document.querySelectorAll('.quantity');

function calculateTotal() {
  let subtotal = 0;

  quantitySelects.forEach((select) => {
    const price = Number(select.dataset.price);
    const qty = Number(select.value);

    subtotal += price * qty;
  });

  document.getElementById('subtotal').innerText = subtotal;
  document.getElementById('total').innerText = subtotal;
}

quantitySelects.forEach((select) => {
  select.addEventListener('change', async () => {
    const cartId = select.dataset.cartId;
    const qty = select.value;

    try {
      const response = await axios.post('/cart/update-quantity', {
        cartId,
        quantity: qty
      });

      if (response.data.success) {
        calculateTotal();
      }
    } catch (error) {
      console.error('Error updating quantity:', error);
    }
  });
});




</script>



<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

</html>