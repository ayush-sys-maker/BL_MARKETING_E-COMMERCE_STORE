<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders | BL TRADING</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@301&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/homecss.css">


    <style>
        body {
            font-family: 'Satoshi', sans-serif;
            background-color: #f8f9fa;
        }
        .order-card {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            margin-bottom: 20px;
            overflow: hidden;
        }
        .order-header {
            background-color: #f8f9fa;
            padding: 15px;
            border-bottom: 1px solid #dee2e6;
        }
        .order-body {
            padding: 15px;
        }
        .order-item {
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }
        .order-item:last-child {
            border-bottom: none;
        }

         .navbar-brand>img{
       width: 100px;
       height: 100px;
        }

      

          @media (min-width: 992px) {
            .navbar .d-flex {
                margin-left: 250px;
            }
            .navbar form {
                margin-left: 3rem;
            }
            .mob{
              display: none;
            }
            .navbar{
            height: 60px;
            }
        }
        

     @media (max-width: 991.98px) {
    .navbar .d-flex {
        margin-left: 0 !important;
        justify-content: flex-start;
        width: 100%;
        margin-top: 1rem;
    }
}


        


       
        @media (max-width: 991.98px) {
            .navbar-collapse {
                padding-top: 1rem;
            }
            
            /* Stack search and buttons below menu */
            .navbar form {
                margin-left: 0 !important;
                margin-top: 1rem;
                width: 100%;
            }
            
            .navbar .d-flex {
                margin-left: 0 !important;
                justify-content: flex-start;
                width: 100%;
                margin-top: 1rem;
            }
            
            /* Hero section adjustments */
            .hero-sub  {
                min-height: 60vh;
                text-align: center;
            }
            
            .hero-sub>.container {
                position: absolute;
                top: 70%;
                left: 50%;
                transform: translate(-50%, -50%);
                font-weight: bold;
            }

            .hero-sub>.container>a{
                font-size: .8rem;
            }

            .hero-sub>.container> p{
                font-size: 1rem;
                line-height: 1.5rem;
                width: 80%;
                margin-left: 40px;
            }
            
            .hero-sub h1 {
                font-size: 1rem !important;
            }
            
            /* Products grid - 2 columns on mobile */
            .products-grid .col-md-3 {
                flex: 0 0 50%;
                max-width: 50%;
            }
            
            /* Why Choose Us - remove left margin */
            .ayush {
                margin-left: 0 !important;
                padding: 0 1rem;
            }
            
            /* Footer - stack columns */
            footer .col {
                margin-bottom: 2rem;
                text-align: center;
            }
            
            footer .nav {
                align-items: center;
            }

           .belowhero {
    margin-top: -30px; /* Small subtle overlap */
    position: relative;
    z-index: 2;
    background: white;
    border-radius: 20px 20px 0 0;
    padding-top: 2rem;
}

            .footercontent{
                display: flex;
                justify-content: center;
                align-items: center;
                height: 150px;
                background-color: #f8f9fa;
                margin-left: -20px;
            }

            .footermedia{
                position: relative;
                left: 210px;
                top: 30px;
            }
            
            .footermedia>div>a>img{
                height: 50px;
                width: 50px;
            }
            
            .footerinventory{
                margin-top: 25px;
            }
            
            .footermore{
                margin-top: 30px;
            }
            
            .navbarcontent{
                margin-top: -20px;
            }
            
            .navbar-brand{
                height: 80px;
            }
            
            .navbar-brand>img{
                height: 100px;
            }
            
            .navbar-toggler{
                margin-top: 20px;
            }
        }
        


        


            
    </style>
</head>
<body>
    <!-- NAVBAR -->
    
<header class="sticky-top bg-white shadow-sm">
    <nav class="navbar navbar-expand-lg container ">
      <div class="container-fluid  navbarcontent   ">
        <!-- Logo/Brand -->
        <div class="navbar-brand " href="#">  <img class="img-fluid" src="/Bl_logo.png" alt="Bl_logo"></div>
        
        <!-- Mobile Toggle -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
          <span class="navbar-toggler-icon"></span>
        </button>
        
        <!-- Main Content -->
        <div class="collapse navbar-collapse" id="navbarContent">
          <!-- Menu -->
          <ul class="navbar-nav gap-lg-4 gap-2 ms-lg-5 ps-lg-5 mb-2 mb-lg-0">
            <li class="nav-item"><a class="nav-link" href="/home">Home</a></li>
            <li class="nav-item"><a class="nav-link" href="/sportswear">Sportswear</a></li>
            <li class="nav-item"><a class="nav-link" href="/WOMEN">Women</a></li>
            <li class="nav-item"><a class="nav-link" href="/SOCKS">Socks </a></li>
          </ul>
          
          <!-- Search -->
          <form class="d-flex ms-lg-5 me-lg-0 mx-auto my-2 my-lg-0" role="search"  action="/search" method="get"  >
            <div class="input-group   ">
              <input class="form-control" type="search" placeholder="Search" name="q">
              <button class="btn btn-outline-secondary" type="submit">
                <i class="fas fa-search"></i>
              </button>
            </div>
          </form>
          
          <!-- Actions -->
          <div class="d-flex gap-2 align-items-center ms-lg-5">
          
            <% if(!user){ %>
            <!-- Login button -->
            <button type="button" class="btn" data-bs-toggle="modal" data-bs-target="#signInModal">
              Sign In
            </button>
            <button type="button" class="btn" data-bs-toggle="modal" data-bs-target="#loginModal">
             Login
            </button>
            <% }else{ %>
              <button  class="btn btn-dark  rounded-pill" onclick="window.location.href='/order/my-orders'" style="font-size: small;"  >MY ORDER</button>

            <form action="/auth/logout" method="post">
            <button type="submit" class="btn fs-6 " >
             <i class="fas fa-sign-out-alt"></i>
            </button>
            </form>
            <% } %>
            
            <button class="btn position-relative p-1">
              <a href="/cart"><i class="fas fa-shopping-cart fs-5"></i></a>
            </button>
          </div>
        </div>
      </div>
    </nav>
</header>
  
    <div class="container py-5">
        <h1 class="mb-4  text-center ">My Orders</h1>
        
        <% if (orders && orders.length > 0) { %>
            <% orders.forEach(order => { %>
                <div class="order-card mb-4  w-100 mx-auto border-2 ">
                    <div class="order-header d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">Order #<%= order.id %></h5>
                            <small class="text-muted">Placed on <%= new Date(order.order_date).toLocaleDateString() %></small>
                        </div>
                        
                        <div class="d-flex flex-column" >
                            <span class="badge w-50 ms-5 mb-2 fs-6   <%= order.payment_status === 'Paid' ? 'bg-success' : 'bg-warning' %>">
                                <%= order.payment_status %>
                            </span>
                            <small class="text-muted">Expected: <%= new Date(order.items[0].delivery_date).toLocaleDateString() %></small>

                        </div>
                    </div>
                    <div class="order-body">
                        <% if (order.items && order.items.length > 0) { %>
                            <% order.items.forEach(item => { %>
                                <div class="order-item d-flex justify-content-between">
                                    <div>
                                        <h6 class="mb-1"><%= item.name %></h6>
                                        <small class="text-muted">Qty: <%= item.quantity %></small>
                                    </div>
                                    <div class="text-end">
                                        <div>₹<%= item.total %></div>
                                    </div>
                                </div>
                            <% }) %>

                            <div class="mt-3 pt-3 border-top d-flex justify-content-between ">
                              <div>
                                <strong>Total:</strong>
                                <strong class="mx-2"  > ₹<%= order.total_amount %></strong>
                                </div>

  <form action="/admin/cancel_order/<%=order.id  %>"    method="post"   >

                                        <button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#exampleModal">
  Cancle
</button>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Confirm Cancel</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div  class=" modal-body mx-2  " >
        <p class="fw-bold"   >DO YOU WANT TO CANCEL THE ORDER</p>

      </div>
     
      <div class="modal-footer">
          <form action="/admin/cancel_order/<%=order.id  %>"    method="post"   >

        <button type="sumbit" class="btn btn-dark">Cancel</button>
         </form>
      </div>
    </div>
  </div>
</div>
                                        
                            </div>



                        <% } else { %>
                            <div class="text-center py-3">
                                <p class="text-muted mb-0">No items in this order</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="text-center py-5">
                <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                <h4>No orders found</h4>
                <p class="text-muted">You haven't placed any orders yet.</p>
                <a href="/home" class="btn btn-dark mt-2">Continue Shopping</a>
            </div>
        <% } %>
    </div>
    

    
<!-- Sign In Modal -->
<div class="modal fade" id="signInModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="mb-3">
          <label class="form-label">Name</label>
          <input type="text" name="name" class="form-control w-100 " required autocomplete="off" >
        </div>
        <div class="modal-header">
          <h5 class="modal-title">Sign In</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form  action="/auth/signup" method="post"   >
            <div class="mb-3">
              <label class="form-label">Email</label>
              <input type="email" name="username" class="form-control w-100 " required autocomplete="off" >
            </div>
            <div class="mb-3">
              <label class="form-label">Password</label>
              <input type="password" name="password" class="form-control  w-100 " required  autocomplete="new-password" >
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              <button type="submit" class="btn btn-primary">Sign In</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  
  <div class="modal fade" id="loginModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Login</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form action="/auth/login" method="post"   >
            <div class="mb-3  ">
              <label class="form-label">Username</label>
              <input type="text" name="username" class="form-control w-100 " required  autocomplete="off" >
            </div>
            <div class="mb-3">
              <label class="form-label">Password</label>
              <input type="password" name="password" class="form-control  w-100 " required  autocomplete="new-password"  >
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              <button type="submit" class="btn btn-primary">Login</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  
  
</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</html>
